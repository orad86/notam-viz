<!--
  Merge these keys into ios/App/App/Info.plist after `npx cap add ios`.
  Capacitor ships a minimal Info.plist; Apple review will reject without:
    - NSLocationWhenInUseUsageDescription (app uses Geolocation API in WKWebView)
    - ITSAppUsesNonExemptEncryption (export compliance)
    - CFBundleDisplayName (matches App Store listing)
-->
<key>NSLocationWhenInUseUsageDescription</key>
<string>NOTAM Visualizer shows your position on the map so you can see nearby NOTAMs. Your location never leaves this device.</string>

<key>ITSAppUsesNonExemptEncryption</key>
<false/>

<key>CFBundleDisplayName</key>
<string>NOTAM Visualizer</string>

<key>UIRequiresFullScreen</key>
<true/>

<!-- Make app's Documents directory visible in the Files app so exported
     GPX/KML/HTML files saved via @capacitor/filesystem show up under
     "On My iPhone → NOTAM Visualizer". No user-facing permission prompt. -->
<key>UIFileSharingEnabled</key>
<true/>
<key>LSSupportsOpeningDocumentsInPlace</key>
<true/>

<key>UIStatusBarStyle</key>
<string>UIStatusBarStyleLightContent</string>

<key>UIViewControllerBasedStatusBarAppearance</key>
<true/>
