# Paste the full Cookie header value from a live Chrome session on
# https://brin.iaa.gov.il/MobileAeroinfo/maiDetails.aspx (see DevTools →
# Network → pick a maiDetails request → Request Headers → Cookie).
#
# Keep this on ONE line. Cookies typically last ~24h; when the API starts
# returning WAF errors, re-extract and replace the value below.
IAA_COOKIE_JAR=__uzma=...; __uzmb=...; TS01e4f122=...; ASP.NET_SessionId=...; uzmxj=...

# Upstash Redis (Vercel KV). Use the WRITE token. Do not point a local
# `STATS_RECORD=1` run at the production store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Hidden /admin usage dashboard. Leave blank to keep /admin disabled (404).
# Choose your own values; never commit them. The secret must be at least
# 32 characters, e.g. `openssl rand -hex 32`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Set to 1 to count launches from a local `next start`.
STATS_RECORD=
